---
import DaisyLayout from "@layouts/DaisyLayout.astro";

import DaisyHero from "@components/DasiyHero.astro";
import DaisyServices from "@components/DaisyServices.astro";
import Contact from "@components/formInfo/Contact.astro";
import Form from "@components/formInfo/Form.astro";

const description =
  "Contact Peridot Therpay to grow and create meaningful change in your life with Victoria Richards. Located in the Ypsilanti / Ann Arbor area. ";
---

<DaisyLayout pageName="Welcome" seoDescription={description}>
  <DaisyHero />
  <DaisyServices />
  <Contact />
  <div class="divider m-auto w-3/4 py-10"></div>
  <Form />
</DaisyLayout>
