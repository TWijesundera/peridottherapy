---
import Services from "@components/Services.astro";
import Hero from "@components/Hero.astro";
import MainLayout from "@layouts/MainLayout.astro";
import Contact from "@components/formInfo/Contact.astro";
import Form from "@components/formInfo/Form.astro";

const description =
  "Contact Peridot Therpay to grow and create meaningful change in your life with Victoria Richards. Located in the Ypsilanti / Ann Arbor area close to EMU and U of M. ";
---

<MainLayout color="bg-white" seoDescription={description}>
  <Hero />
  <Services />
  <Contact />
  <br />
  <hr class="m-auto w-3/4 border-gray-400" />
  <Form />
</MainLayout>
