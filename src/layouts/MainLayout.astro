---
import { SEO } from "astro-seo";

import "../styles/peridot.css";
import PeridotHeader from "@components/PeridotHeader.astro";
import Favicon from "@images/FlowerPicture.png";

const { color, pageName, seoDescription } = Astro.props;
---

<!doctype html>
<html class="scroll-smooth" lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/x-icon" href={Favicon.src} />
    <link
      rel="preload"
      href="/fonts/dm-serif-display-regular.woff2"
      as="font"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/notosans.woff2"
      type="font/woff2"
      as="font"
      crossorigin
    />
    <SEO
      titleTemplate="Peridot Therapy: %s"
      description={seoDescription}
      title={pageName}
      titleDefault="Peridot Therapy"
    />
  </head>
  <body class={color}>
    <PeridotHeader />
    <slot />
  </body>
</html>
