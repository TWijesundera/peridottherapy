---
import Location from "@images/Location.svg";

const officeLocation = "Ypsilanti Area";
const insurances = ["Blue Cross Blue Shield", "Aetna", "Priority Health"];
const privatePay: Record<string, string> = {
  Individual: "$160",
  Couples: "$210",
};
---

<div class="bg-peridot">
  <div class="flex flex-col place-items-center gap-y-5 px-4 pb-10 sm:px-10">
    <h2
      id="services"
      class="font-serif-display my-7 text-2xl md:text-3xl xl:text-4xl"
    >
      Services
    </h2>
    <div
      class="md:grid md:grid-cols-2 md:grid-rows-1 md:gap-4 md:place-self-center lg:max-w-10/12"
    >
      <div class="rounded-md bg-white p-8">
        <h2 class="font-serif-display p-2 text-xl lg:text-2xl">
          In person & online sessions available
        </h2>
        <div class="inline-flex items-center p-2 text-xl">
          <Location />
          <p class="lg:text-2xl">{officeLocation}</p>
        </div>
        <p class="font-noto p-2 lg:text-xl">
          While I work with a broad range of clients, my greatest experience is
          with couples, women, and young adults navigating life transitions or
          experiencing symptoms of anxiety and depression.
        </p>
      </div>
      <div
        class="mt-5 flex flex-row place-content-evenly rounded-md bg-white p-8 md:mt-0"
      >
        <div
          class="flex flex-col place-items-center gap-5 self-center px-3 text-center"
        >
          <h2 class="font-serif-display text-xl lg:text-2xl">Insurances</h2>
          {
            insurances.map((insurance) => (
              <p class="font-noto lg:text-xl">{insurance}</p>
            ))
          }
        </div>
        <div class="border-l-1"></div>
        <div class="inline-flex flex-col gap-5 self-center px-3 text-center">
          <h2 class="font-serif-display text-xl lg:text-2xl">Private Pay</h2>
          {
            Object.keys(privatePay).map((pay) => (
              <p class="font-noto lg:text-xl">
                {pay} - {privatePay[pay]}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
