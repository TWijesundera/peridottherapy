---
import type { HTMLAttributes } from "astro/types";
import PeridotHeaderLink from "@components/header/PeridotHeaderLink.astro";

type Props = HTMLAttributes<"nav">;

const { class: className, ...props } = Astro.props;
const links: Record<string, string> = {
  Services: "/#services",
  Contact: "/#contact-form",
  "About Me": "/about",
};
---

<div id="nav" class:list={[className]} {...props}>
  {
    Object.keys(links).map((title) => (
      <PeridotHeaderLink
        href={links[title]}
        class="font-serif-display pr-2 text-center text-xl hover:bg-gray-100"
      >
        {title}
      </PeridotHeaderLink>
    ))
  }
</div>
