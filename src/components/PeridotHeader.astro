---
import Navigation from "./header/Navigation.astro";
import Hamburger from "./header/Hamburger.astro";
---

<script>
  document.querySelector("#menu")?.addEventListener("click", () => {
    const nav = document.querySelector("#nav");
    nav?.classList.toggle("hidden");
    nav?.classList.toggle("flex");
  });
</script>

<header class="bg-white p-5" role="banner">
  <nav
    class="flex flex-row flex-wrap items-center justify-between md:flex-nowrap md:justify-evenly"
    role="navigation"
  >
    <a class="grow-3 md:ml-15" href="/">
      <h1
        class="font-serif-display text-2xl tracking-wide sm:text-3xl lg:text-4xl"
      >
        Peridot Therapy
      </h1>
    </a>
    <Hamburger class="visible md:hidden" />
    <Navigation
      class="mt-3 hidden w-full grow-2 flex-col gap-3 md:m-auto md:inline-flex md:w-auto md:flex-row md:items-center md:justify-evenly"
    />
  </nav>
</header>
